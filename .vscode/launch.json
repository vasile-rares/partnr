{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/backend/src/ClientPortal.Api/bin/Debug/net10.0/ClientPortal.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/ClientPortal.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5051",
        "Seed__ReseedOnChange": "true"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["API"],
      "preLaunchTask": "frontend",
      "stopAll": true
    }
  ]
}
