{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/backend/src/Services/Core/Partnr.Core.Api/bin/Debug/net10.0/Partnr.Core.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/Services/Core/Partnr.Core.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
        "Seed__ReseedOnChange": "true"
      }
    },
    {
      "name": "Integrations",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-integrations",
      "program": "${workspaceFolder}/backend/src/Services/Integrations/Partnr.Integrations.Api/bin/Debug/net10.0/Partnr.Integrations.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/Services/Integrations/Partnr.Integrations.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317"
      }
    },
    {
      "name": "Notifications",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-notifications",
      "program": "${workspaceFolder}/backend/src/Services/Notifications/Partnr.Notifications.Api/bin/Debug/net10.0/Partnr.Notifications.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/Services/Notifications/Partnr.Notifications.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317"
      }
    },
    {
      "name": "Storage",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-storage",
      "program": "${workspaceFolder}/backend/src/Services/Storage/Partnr.Storage.Api/bin/Debug/net10.0/Partnr.Storage.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/Services/Storage/Partnr.Storage.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317"
      }
    },
    {
      "name": "Gateway",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-gateway",
      "program": "${workspaceFolder}/backend/src/Partnr.Gateway/bin/Debug/net10.0/Partnr.Gateway.dll",
      "cwd": "${workspaceFolder}/backend/src/Partnr.Gateway",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
        "ASPNETCORE_URLS": "http://localhost:5050"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["API", "Integrations", "Notifications", "Storage", "Gateway"],
      "preLaunchTask": "frontend",
      "stopAll": true
    }
  ]
}
