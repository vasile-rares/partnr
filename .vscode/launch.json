{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/backend/src/Services/Workspaces/Partnr.Workspaces.Api/bin/Debug/net10.0/Partnr.Workspaces.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/Services/Workspaces/Partnr.Workspaces.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Seed__ReseedOnChange": "true"
      }
    },
    {
      "name": "Gateway",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-gateway",
      "program": "${workspaceFolder}/backend/src/Gateway/Partnr.Gateway/bin/Debug/net10.0/Partnr.Gateway.dll",
      "cwd": "${workspaceFolder}/backend/src/Gateway/Partnr.Gateway",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5050"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["API", "Gateway"],
      "preLaunchTask": "frontend",
      "stopAll": true
    }
  ]
}
