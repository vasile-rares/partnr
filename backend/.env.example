# Local development infrastructure for docker-compose.yml. Copy this file to .env (ignored by git); without it the same values are used.
#
# These values are also written in the services' appsettings.Development.json (connection strings, broker address, storage keys).
# Change one here and the same value has to change there (or in user secrets), or the services cannot connect.

POSTGRES_DB=partnr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1q2w3e

RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

RABBITMQ_DEFAULT_USER=partnr
RABBITMQ_DEFAULT_PASS=partnr

# Which optional services `docker compose up` starts: "observability" is the telemetry dashboard (http://localhost:18888). Empty to leave it out.
COMPOSE_PROFILES=observability
