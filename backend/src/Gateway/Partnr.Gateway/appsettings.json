{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Session": {
    "CookieName": ".AspNetCore.Identity.Application"
  },
  "Services": {
    "Workspaces": { "GrpcAddress": "http://localhost:5052" }
  },
  "ReverseProxy": {
    "Routes": {
      "integrations-api": {
        "ClusterId": "integrations",
        "Order": 1,
        "Match": { "Path": "/api/integrations/{**catch-all}" }
      },
      "notifications-api": {
        "ClusterId": "notifications",
        "Order": 1,
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "notifications-hub": {
        "ClusterId": "notifications",
        "Order": 1,
        "Match": { "Path": "/api/hubs/{**catch-all}" }
      },
      "workspaces-api": {
        "ClusterId": "workspaces",
        "Order": 2,
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "workspaces": {
        "Destinations": {
          "api": { "Address": "http://localhost:5051" }
        }
      },
      "integrations": {
        "Destinations": {
          "api": { "Address": "http://localhost:5053" }
        }
      },
      "notifications": {
        "Destinations": {
          "api": { "Address": "http://localhost:5055" }
        }
      }
    }
  }
}
